# ---------------------------------------------------------------------------
# Starter Kit environment. Copy to .env for local development.
# Secrets must be generated per installation (the installer does it for you):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
APP_NAME="Starter Kit"
# Public origin (what users open in the browser). In Docker this is the proxy.
APP_URL=http://localhost:3000
# Extra trusted origins for auth (comma separated)
TRUSTED_ORIGINS=

API_PORT=3001
# Used by Nuxt SSR to reach the API inside the network
NUXT_API_INTERNAL_URL=http://localhost:3001

# Transactional database (also hosts the durable job queue)
DATABASE_URL=postgres://starter:starter@localhost:5432/starter
# Optional privileged URL used only by migrations (CREATE EXTENSION, DDL)
DATABASE_MIGRATION_URL=
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# >= 32 chars, random
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# 32 random bytes, base64. Keep it outside database backups.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_PREVIOUS_KEYS=

# Owner pre-assignment (trusted bootstrap performed by the migrate service / installer)
OWNER_EMAIL=
REGISTRATION_MODE=invite-only
OTP_LENGTH=6
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
SESSION_EXPIRES_DAYS=7

# Mail: smtp (Mailpit in development) | resend | log
MAIL_TRANSPORT=smtp
MAIL_FROM="Starter Kit <no-reply@localhost>"
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# Files: local volume or S3 compatible
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Installation-level modules
FEATURE_ORGANIZATIONS=false
FEATURE_AI=true
FEATURE_RAG=true

# Deterministic AI provider for tests/demos. Never enable in production.
AI_TEST_PROVIDER_ENABLED=false
AI_ALLOW_PRIVATE_ENDPOINTS=false
MODEL_CATALOG_URL=https://models.dev/api.json
# Optional CLP display conversion: none | mindicador
FX_PROVIDER=none

# Outbound HTTP proxy (corporate networks). Node only honours HTTP(S)_PROXY when
# NODE_USE_ENV_PROXY=1; add the proxy CA with NODE_EXTRA_CA_CERTS when it intercepts TLS.
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,postgres,api,web
# NODE_USE_ENV_PROXY=1
# NODE_EXTRA_CA_CERTS=/path/to/ca.pem

# OpenAPI / Swagger UI: public | protected (permission api.docs) | disabled
OPENAPI_DOCS=protected

UPLOAD_MAX_BYTES=20971520
AUDIO_MAX_BYTES=26214400
RAG_FETCH_ALLOW_PRIVATE=false
RAG_FETCH_MAX_BYTES=10485760

# --- Docker Compose (local-db / rag-db profiles) ---
POSTGRES_USER=starter
POSTGRES_PASSWORD=
POSTGRES_DB=starter
POSTGRES_APP_USER=starter_app
POSTGRES_APP_PASSWORD=
RAG_POSTGRES_PASSWORD=
# Edge proxy address: ":8080" for local HTTP, a domain (app.example.com) for automatic HTTPS
SITE_ADDRESS=:8080
