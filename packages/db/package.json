{
  "name": "@starter/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/schema/index.d.ts", "default": "./dist/schema/index.js" }
  },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc -b",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "check": "drizzle-kit check --config drizzle.config.ts"
  },
  "dependencies": {
    "@starter/config": "workspace:*",
    "@starter/observability": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
